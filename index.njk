---
layout: base.njk
title: Thought Essays
---
<div class="home-hero">
  <h1 class="home-title">Thought Essays</h1>
  <p class="home-subtitle">A little blog for my big thoughts :D</p>
</div>

<ul class="post-list">
  {% for post in collections.posts %}
  <li class="post-list-item">
    <a href="{{ post.url }}">{{ post.data.title }}</a>
    {% if post.data.date %}<span class="post-list-date">{{ post.data.date | readableDate }}</span>{% endif %}
    {% if post.data.summary %}<p class="post-list-summary">{{ post.data.summary }}</p>{% endif %}
  </li>
  {% endfor %}
</ul>
